font-family   = "Monaspace"
font-size     = 20
custom-shader = ./shaders/bloom.glsl
custom-shader = ./shaders/bettercrt.glsl
custom-shader = ./shaders/tft.glsl

macos-option-as-alt = true
title = " "
macos-titlebar-proxy-icon = hidden
keybind = alt+left=unbind
keybind = alt+right=unbind

# Background and foreground colors
background = #0a0f09
foreground = #95ff80
selection-foreground = #050804
selection-background = #7bcf6b

# Standard colors
palette = 0=#050804
palette = 1=#FF5555
palette = 2=#6ebf5d
palette = 3=#d4b84f
palette = 4=#62a058
palette = 5=#7bcf6b
palette = 6=#6ebf5d
palette = 7=#95ff80

# Bright colors
palette = 8=#62a058
palette = 9=#FF5555
palette = 10=#7bcf6b
palette = 11=#d4b84f
palette = 12=#95ff80
palette = 13=#95ff80
palette = 14=#7bcf6b
palette = 15=#95ff80
